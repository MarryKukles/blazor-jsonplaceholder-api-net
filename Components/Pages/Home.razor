
@page "/"
@using System.Net.Http.Json
@using BlazorUsersJsonPlaceHolderApi.Models
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Usuários JSONPlaceholder</PageTitle>

<h1>Usuários da API JSONPlaceholder</h1>

<p>Os dados do primeiro usuário são exibidos no console.</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient();

            var usuarios = await httpClient
                .GetFromJsonAsync<List<User>>(
                    "https://jsonplaceholder.typicode.com/users");

            if (usuarios != null && usuarios.Count > 0)
            {
                var primeiroUsuario = usuarios[0];

                Console.WriteLine(
                    $"Nome: {primeiroUsuario.Name}");

                Console.WriteLine(
                    $"Cidade: {primeiroUsuario.Address.City}");

                Console.WriteLine(
                    $"Empresa: {primeiroUsuario.Company.Name}");
            }
            else
            {
                Console.WriteLine(
                    "Nenhum usuário foi encontrado.");
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine(
                $"Erro ao consumir a API: {ex.Message}");
        }
    }
}
